{
  "rules": {
    ".read": false,
    ".write": false,
    "families": {
      "$family": {
        ".read": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
        "meta": {
          "quizVersion": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.isNumber()"
          }
        },
        "profiles": {
          "$id": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.child('updatedAt').val() === now || (data.exists() && newData.child('json').val() === data.child('json').val() && newData.child('updatedAt').val() === data.child('updatedAt').val())",
            "points": { ".validate": "newData.isNumber()" }
          }
        },
        "categories": {
          ".indexOn": ["updatedAt"],
          "$id": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.child('updatedAt').val() === now"
          }
        },
        "questions": {
          ".indexOn": ["updatedAt"],
          "$id": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.child('updatedAt').val() === now"
          }
        },
        "exercises": {
          "$id": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.child('updatedAt').val() === now"
          }
        },
        "assignments": {
          "$child": {
            "$id": {
              ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
              ".validate": "newData.hasChildren(['updatedAt', 'tries'])",
              "updatedAt": { ".validate": "newData.val() === now || newData.val() === data.val()" },
              "tries": { ".validate": "newData.isNumber()" }
            }
          }
        },
        "sessions": {
          "$child": {
            ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4'",
            ".validate": "newData.child('updatedAt').val() === now"
          }
        },
        "results": {
          "$child": {
            "$id": {
              ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4' && (!data.exists() || !newData.exists())",
              ".validate": "$id.matches(/^[0-9]{10}$/) && newData.child('createdAt').val() === now"
            }
          }
        },
        "history": {
          "$child": {
            ".indexOn": ["createdAt", "assignmentId", "practiceOf"],
            "$id": {
              ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4' && !data.exists()",
              ".validate": "$id.matches(/^[0-9]{10}$/) && newData.child('createdAt').val() === now && newData.child('totalEarned').isNumber() && newData.child('totalStars').isNumber()"
            }
          }
        },
        "pointUsage": {
          "$child": {
            "$id": {
              ".write": "auth != null && $family === 'b18c7383e8a365aad9de80456aeca58a4e33dafaf14836e4' && !data.exists()",
              ".validate": "$id.matches(/^[0-9]{10}$/) && newData.child('createdAt').val() === now && newData.child('totalUsed').isNumber()"
            }
          }
        }
      }
    }
  }
}
